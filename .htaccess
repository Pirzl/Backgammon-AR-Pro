<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://dlnzupvxtqozhczrenbn.supabase.co blob: https://www.googletagmanager.com; worker-src 'self' blob: https://dlnzupvxtqozhczrenbn.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://ui-avatars.com https://*.google-analytics.com https://*.googletagmanager.com https://m.media-amazon.com https://images-na.ssl-images-amazon.com https://images-amazon.com https://*.ssl-images-amazon.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://turn.time4vps.cloud https://fonts.googleapis.com https://fonts.gstatic.com https://generativelanguage.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cdn.jsdelivr.net https://dlnzupvxtqozhczrenbn.supabase.co; object-src 'none'; base-uri 'self';"
  Header set Permissions-Policy "microphone=(self), camera=(self)"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # SPA fallback handled by Vite static build; keep files as-is
</IfModule>
